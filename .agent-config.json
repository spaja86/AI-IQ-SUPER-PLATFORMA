{
  "agents": {
    "ci-bot": {
      "enabled": true,
      "languages": [
        "typescript",
        "javascript"
      ],
      "autoFix": true,
      "requireApproval": false,
      "testCommand": "npm run test",
      "lintCommand": "npm run lint",
      "workflowFile": ".github/workflows/omega-auto-build.yml"
    },
    "human-review": {
      "enabled": true,
      "requireApproval": true,
      "minReviewers": 1
    },
    "deploy-bot": {
      "enabled": false,
      "trigger": "merge-to-main",
      "requireGreenCI": true,
      "environments": [
        "staging",
        "production"
      ],
      "workflowFile": ".github/workflows/vercel-deploy.yml"
    },
    "security-scanner": {
      "enabled": true,
      "scanOnPR": true,
      "nightly": true,
      "blockCritical": true,
      "scanSecrets": true,
      "auditDependencies": true,
      "workflowFile": ".github/workflows/security-scanner.yml",
      "labels": [
        "security:needs-review",
        "security:review-needed"
      ]
    },
    "multi-repo-sync-agent": {
      "enabled": true,
      "linkedRepos": [
        "spaja86/IO-OPENUI-AO"
      ],
      "syncInterval": "weekly",
      "syncOnPush": true,
      "fields": [
        "versions",
        "labels",
        "milestones",
        "agent-config",
        "readme-links"
      ],
      "excludePrivate": false,
      "sourceOfTruthDocs": [
        "docs/MULTI-REPO-LINKS.md",
        "docs/ROADMAP.md"
      ]
    },
    "calculator-validator-agent": {
      "enabled": false,
      "scope": "IO-OPENUI-AO",
      "performanceThreshold": 100,
      "testSuite": "calculator-tests"
    },
    "analytics-bot": {
      "enabled": true,
      "schedules": {
        "nightly": "0 2 * * *",
        "weekly": "0 0 ? * MON"
      },
      "generateReports": true,
      "trackMetrics": [
        "pr-review-time",
        "automated-merges",
        "security-findings",
        "deployment-frequency"
      ],
      "sourceOfTruthDoc": "docs/ROADMAP.md"
    }
  },
  "orgSettings": {
    "signCommits": true,
    "autoMergeAllowed": [
      "hotfix/*"
    ],
    "protectedBranches": [
      "main",
      "develop"
    ],
    "requireAllChecks": true
  },
  "finops": {
    "sourceOfTruth": {
      "productionDeploy": "vercel-git-integration",
      "githubActionsRole": "quality-gates-only"
    },
    "monthlyBudget": {
      "currency": "USD",
      "alertsPercent": [
        50,
        75,
        90,
        100
      ]
    },
    "ownership": {
      "team": "IO-OPENUI-AO / SUPER-PLATFORMA",
      "costCenterTagRequired": true
    },
    "kpis": [
      "cost-per-deployment",
      "cost-per-active-user",
      "mttr",
      "build-duration",
      "deployment-success-rate"
    ],
    "reviewCadence": {
      "monthlyOpsReview": true,
      "quarterlyBusinessReview": true,
      "incidentEscalationChannel247": true
    }
  },
  "sourceOfTruth": {
    "roadmap": "docs/ROADMAP.md",
    "multiRepo": "docs/MULTI-REPO-LINKS.md",
    "finops": "docs/finops-enterprise-operating-model.md",
    "security": "docs/SECURITY.md",
    "goLive": "docs/GO-LIVE.md"
  },
  "multiRepoLinks": {
    "primaryRepo": "spaja86/AI-IQ-SUPER-PLATFORMA",
    "linkedRepos": [
      {
        "repo": "spaja86/IO-OPENUI-AO",
        "syncFields": [
          "versions",
          "labels",
          "milestones",
          "agent-config",
          "readme-links",
          "follow-up-refs"
        ],
        "syncTrigger": "weekly",
        "trackingDoc": "docs/MULTI-REPO-LINKS.md"
      }
    ],
    "crossRepoVersionPolicies": {
      "npmPackages": "minor-compatible",
      "githubActions": "patch-exact",
      "docsAndLinks": "same-change-window"
    }
  },
  "depon": {
    "platform": "120M-US-States",
    "targetUsers": 120000000,
    "targetStates": 50,
    "modules": {
      "total": 12,
      "active": 4,
      "planned": 8
    },
    "scalingPhases": {
      "phase1": { "userRange": "0-10M", "regions": 3, "depons": ["DEPON-01","DEPON-02","DEPON-03","DEPON-04"] },
      "phase2": { "userRange": "10-50M", "regions": 6, "depons": ["DEPON-05","DEPON-06","DEPON-07","DEPON-08"] },
      "phase3": { "userRange": "50-120M", "regions": 12, "depons": ["DEPON-09","DEPON-10","DEPON-11","DEPON-12"] }
    },
    "deployWorkflow": ".github/workflows/depon-deploy.yml",
    "testSuite": "src/tests/depon/depon-registry.test.ts",
    "migration": "supabase/migrations/019_depon_us_states_platform.sql",
    "sla": {
      "uptimePercent": 99.99,
      "maxLatencyMs": 100
    }
  },
  "kpiTracking": {
    "enabled": true,
    "reportingCadence": "daily",
    "trackedMetrics": [
      "cost-per-deployment",
      "cost-per-active-user",
      "mttr",
      "build-duration",
      "deployment-success-rate",
      "agent-reliability-score",
      "security-scan-coverage"
    ],
    "owners": {
      "platformOps": [
        "build-duration",
        "deployment-success-rate",
        "mttr"
      ],
      "finops": [
        "cost-per-deployment",
        "cost-per-active-user"
      ],
      "automation": [
        "agent-reliability-score"
      ],
      "security": [
        "security-scan-coverage"
      ]
    }
  }
}
